{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "lms-root",
  "private": true,
  "scripts": {
    "dev": "npx concurrently -n backend,frontend -c cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
