#!/bin/sh
# Optional: after `git pull` / merge, bump deploy version (run from repo root on SERVER only).
# Install: cp scripts/git-hooks/post-merge.sample .git/hooks/post-merge && chmod +x .git/hooks/post-merge
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
if [ -f "$ROOT/backend/artisan" ]; then
  (cd "$ROOT/backend" && php artisan app:bump-deploy-version --no-interaction) || true
fi
